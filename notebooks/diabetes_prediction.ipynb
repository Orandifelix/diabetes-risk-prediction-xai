    "# _BMI5 is stored as BMI × 100 in BRFSS XPT format\n",
    "# e.g. 2847 = BMI of 28.47\n",
    "df_model[\"_BMI5\"] = df_model[\"_BMI5\"] / 100\n",
    "\n",
    "print(\"✅ _BMI5 rescaled (÷ 100)\")\n",
    "print(f\"   Min BMI : {df_model['_BMI5'].min():.2f}\")\n",
    "print(f\"   Max BMI : {df_model['_BMI5'].max():.2f}\")\n",
    "print(f\"   Mean BMI: {df_model['_BMI5'].mean():.2f}\")"
   ]
  },
