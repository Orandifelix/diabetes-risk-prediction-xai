    "    \"CHCKDNY2\": \"Kidney Disease\",\n",
    "    \"_MICHD\": \"Heart Disease\",\n",
    "}\n",
    "\n",
    "features = list(FEATURE_LABELS.keys())\n",
    "\n",
    "# Missing value bar chart\n",
    "missing_pct = (df_model.isnull().mean() * 100).sort_values(ascending=False)\n",
    "missing_pct = missing_pct[missing_pct > 0]\n",
    "\n",
    "# Colour bars according to missing percentage\n",
    "colors = []\n",
    "for val in missing_pct.values:\n",
    "    if val < 5:\n",
    "        colors.append(\"#10B981\")   # Green\n",
    "    elif val < 20:\n",
    "        colors.append(\"#F59E0B\")   # Orange\n",
    "    else:\n",
    "        colors.append(\"#EF4444\")   # Red\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 5))\n",
    "\n",
    "bars = ax.barh(\n",
    "    [FEATURE_LABELS.get(c, c) for c in missing_pct.index],\n",
    "    missing_pct.values,\n",
    "    color=colors,\n",
    "    edgecolor=\"black\",\n",
    "    linewidth=0.6\n",
    ")\n",
    "\n",
    "# Add percentage labels\n",
    "for bar, val in zip(bars, missing_pct.values):\n",
    "    ax.text(\n",
    "        val + 0.2,\n",
    "        bar.get_y() + bar.get_height()/2,\n",
    "        f\"{val:.2f}%\",\n",
    "        va=\"center\",\n",
    "        fontsize=10\n",
    "    )\n",
    "\n",
    "# Threshold lines\n",
    "ax.axvline(\n",
    "    5,\n",
    "    color=\"#F59E0B\",\n",
    "    linestyle=\"--\",\n",
    "    linewidth=1.2,\n",
    "    label=\"5% threshold\"\n",
    ")\n",
    "\n",
    "ax.axvline(\n",
    "    20,\n",
    "    color=\"#EF4444\",\n",
    "    linestyle=\"--\",\n",
    "    linewidth=1.2,\n",
    "    label=\"20% threshold\"\n",
    ")\n",
    "\n",
    "ax.set_xlabel(\"Missing Values (%)\", fontsize=11)\n",
    "ax.set_title(\n",
    "    \"Missing Values by Feature\",\n",
    "    fontsize=13,\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "\n",
    "ax.legend(fontsize=10)\n",
    "ax.invert_yaxis()\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
    "    \"../images/02_eda/missing_value_visualisation.png\",\n",
    "    dpi=300,\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "print(\"✅ Figure saved → ../images/02_eda/missing_value_visualisation.png\")"
   ]
