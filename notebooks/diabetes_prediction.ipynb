    "# Inspect raw unique values per feature\n",
    "# Reveals BRFSS special codes before recoding\n",
    "print(\"=== Raw Unique Values Per Feature ===\\n\")\n",
    "for col in df_model.columns:\n",
    "    vals = sorted(df_model[col].dropna().unique().astype(int).tolist())\n",
