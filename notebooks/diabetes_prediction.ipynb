     ]
    }
   ],
   "source": [
    "\n",
    "# Configuration of features\n",
    "\n",
    "FEATURE_LABELS = {\n",
    "    \"_BMI5\": \"BMI\",\n",
    "    \"_AGE80\": \"Age\",\n",
    "    \"SEXVAR\": \"Sex\",\n",
    "    \"_IMPRACE\": \"Race/Ethnicity\",\n",
    "    \"GENHLTH\": \"General Health\",\n",
    "    \"PHYSHLTH\": \"Poor Physical Health Days\",\n",
    "    \"SMOKE100\": \"Smoking\",\n",
    "    \"_TOTINDA\": \"Physical Activity\",\n",
    "    \"EDUCA\": \"Education Level\",\n",
    "    \"INCOME3\": \"Income Level\",\n",
    "    \"_RFHYPE6\": \"Hypertension\",\n",
