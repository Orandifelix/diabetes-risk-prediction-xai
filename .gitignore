# ─────────────────────────────────────────────
# Diabetes Risk Predictor — .gitignore
# ─────────────────────────────────────────────

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg

# Ignore only root-level Python build directories
/lib/
/lib64/

# ── Virtual Environments ──────────────────────
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/
*.conda

# ── Jupyter Notebooks ─────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/
profile_default/
ipython_config.py

# ── Data Files ────────────────────────────────
datasets/raw/*.csv
datasets/raw/*.xlsx
datasets/raw/*.json
datasets/raw/*.parquet
datasets/raw/*.zip

datasets/processed/*.csv
datasets/processed/*.xlsx
datasets/processed/*.json
datasets/processed/*.parquet

# Keep placeholder files
!datasets/raw/.gitkeep
!datasets/processed/.gitkeep

# ── Model Artifacts ───────────────────────────
# Uncomment if model artifacts become too large
# models/*.joblib
# models/*.pkl
# models/*.h5
# models/*.pt
# models/*.onnx

# ── Environment & Secrets ─────────────────────
.env.local
.env.development
.env.production
.env.test
*.env
secrets.yml
secrets.yaml
config/secrets*

# ── OS Files ──────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*~
.fuse_hidden*
.directory
.Trash-*

# ── IDEs and Editors ──────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.iml
*.iws
*.ipr

*.swp
*.swo
*.swn
Session.vim
.netrwhist

\#*\#
.\#*

.spyderproject.cfg
.spyproject/

# ── Testing & Coverage ────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
pytest.xml
test-results/
.tox/
.nox/

# ── Linting ───────────────────────────────────
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ── Logs ──────────────────────────────────────
*.log
logs/
*.log.*
pip-log.txt
pip-delete-this-directory.txt

# ── Temporary Files ───────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.rej
tmp/
temp/

# ── Node.js / Next.js ─────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.nuxt/
.cache/
.parcel-cache/
*.tsbuildinfo
.npm

# ── Docker ────────────────────────────────────
.dockerignore

# ── Miscellaneous ─────────────────────────────
*.pid
*.seed
*.pid.lock
.hypothesis/

# Benchmark data
.benchmarks/datasets/raw/*.XPT
datasets/raw/*.XPT