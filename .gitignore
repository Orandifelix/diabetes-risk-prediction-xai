# ─────────────────────────────────────────────
# Diabetes Risk Predictor — .gitignore
# ─────────────────────────────────────────────

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Virtual Environments ──────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/
*.conda

# ── Jupyter Notebooks ─────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/
profile_default/
ipython_config.py

# ── Data Files ────────────────────────────────
# Raw and processed datasets — too large for Git
datasets/raw/*.csv
datasets/raw/*.xlsx
datasets/raw/*.json
datasets/raw/*.parquet
datasets/raw/*.zip
datasets/processed/*.csv
datasets/processed/*.xlsx
datasets/processed/*.json
datasets/processed/*.parquet

# Keep .gitkeep placeholder files
!datasets/raw/.gitkeep
!datasets/processed/.gitkeep

# ── Model Artifacts ───────────────────────────
# Uncomment these if model files become too large for Git
# models/*.joblib
# models/*.pkl
# models/*.h5
# models/*.pt
# models/*.onnx

# ── Environment & Secrets ─────────────────────
.env
.env.local
.env.development
.env.production
.env.test
*.env
secrets.yml
secrets.yaml
config/secrets*

# ── OS Files ──────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ── IDEs and Editors ──────────────────────────
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains / PyCharm
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*.swn
Session.vim
.netrwhist

# Emacs
*~
\#*\#
.\#*

# Spyder
.spyderproject.cfg
.spyproject/

# ── Testing & Coverage ────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
pytest.xml
test-results/
.tox/
.nox/

# ── Linting ───────────────────────────────────
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ── Logs ──────────────────────────────────────
*.log
logs/
*.log.*
pip-log.txt
pip-delete-this-directory.txt

# ── Temporary Files ───────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.rej
tmp/
temp/

# ── Node.js (for frontend in app/) ────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.nuxt/
.cache/
.parcel-cache/
*.tsbuildinfo
.npm

# ── Docker ────────────────────────────────────
.dockerignore

# ── Miscellaneous ─────────────────────────────
*.pid
*.seed
*.pid.lock
.hypothesis/
.benchmarks/datasets/raw/CDC_LLCP2023.XPT
datasets/raw/CDC_LLCP2023.XPT
